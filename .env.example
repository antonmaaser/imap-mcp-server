# Generated automatically by: npm run setup -- init
# These are host paths. The container always uses /data/config and /data/attachments.
IMAP_MCP_CONFIG_DIR=./.imap-mcp
IMAP_MCP_DOWNLOAD_DIR=./downloads
IMAP_MCP_TOKEN_FILE=./.imap-mcp/bearer-token
# Replace with your numeric id -u / id -g (init does this for you).
IMAP_MCP_UID=1000
IMAP_MCP_GID=1000
IMAP_MCP_LOCAL_PORT=47863
# Add your reverse proxy's public hostname. Preserve the loopback hosts for health checks.
IMAP_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Empty rejects all browser Origin headers. Native MCP clients usually omit Origin.
IMAP_MCP_ALLOWED_ORIGINS=
IMAP_MCP_READ_ONLY=false
IMAP_MCP_ENABLED_TOOLS=
IMAP_MAX_UPLOAD_SIZE=26214400
IMAP_UPLOAD_TTL_MS=86400000
IMAP_SPAM_DOMAINS=
IMAP_WHITELIST_DOMAINS=
