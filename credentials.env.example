# Optional raw Compose env file (Compose >=2.30). Keep chmod 600.
# Values are literal: do not quote, interpolate or prefix with export.
# Only already-configured accounts use these credentials. Restart to apply.
# IMAP_MCP_ACCOUNT_WORK_GMAIL_IMAP_USERNAME=me@example.com
# IMAP_MCP_ACCOUNT_WORK_GMAIL_IMAP_PASSWORD=your-app-password
# IMAP_MCP_ACCOUNT_WORK_GMAIL_SMTP_USERNAME=me@example.com
# IMAP_MCP_ACCOUNT_WORK_GMAIL_SMTP_PASSWORD=your-app-password
